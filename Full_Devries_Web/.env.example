DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
TEST_DATABASE_URL=

# Supabase (URL + anon key are safe to expose; service role key is secret)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=crm-files
STORAGE_BACKEND=auto

# Comma-separated Google emails that should be admins (first-ever user becomes
# admin automatically if this is empty). Login is Google-only.
ADMIN_EMAILS=

# Optional email notifications (requires SMTP configured in the app's
# Email Setup modal + `npm install` for nodemailer)
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_RECIPIENT_EMAIL=

SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
ENABLE_DB_BACKUPS=true
