[TEMPLATE]
[TEMPLATE]
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
TEST_DATABASE_URL=

# Supabase (URL + anon key are safe to expose; service role key is secret)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=client-files
STORAGE_BACKEND=auto

# Comma-separated Google emails that are admins. Login is Google-only and
# there is NO auto-admin fallback — admins come only from this list (or from
# an admin promoting a user via Settings → Users). Restricted/sales users see
# only jobs assigned to them.
ADMIN_EMAILS=

# Public base URL used for links inside notification emails (e.g. the note link).
APP_URL=https://roofing-web.onrender.com

# Optional email notifications. Emails are sent automatically once a complete
# SMTP profile is saved in the app's Email Setup modal (production already has
# one). EMAIL_NOTIFICATIONS_ENABLED overrides: 'true' forces sending (use when
# SMTP comes from EMAIL_USER/EMAIL_PASS env vars); 'false' forces it off.
EMAIL_NOTIFICATIONS_ENABLED=
NOTIFICATION_RECIPIENT_EMAIL=

SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
ENABLE_DB_BACKUPS=true
